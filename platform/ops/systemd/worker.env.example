# /etc/collect/worker.env  (chmod 600, owned by collect)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=collect_platform
DB_USER=collect
DB_PASSWORD=change-me
WORKER_LOCK=/var/lock/collect-worker.lock
WORKER_OUT_DIR=/var/lib/collect/out
WORKER_TIMEOUT_START_SEC=240
WORKER_STALE_MARGIN_SEC=60
WORKER_REMINDER_TIME=18:00
WORKER_ESCALATE_TIME=18:10
WORKER_CLOSE_TIME=18:20
WORKER_RETRY_START=18:25
WORKER_RETRY_END=18:35
WORKER_ALERT_TIME=18:40
