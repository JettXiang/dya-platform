# /etc/collect/backup.env  (chmod 600)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=collect_platform
DB_USER=collect
DB_PASSWORD=change-me
# DB_USER 需具备：目标库 SELECT/ALL；全局 RELOAD、PROCESS、REPLICATION CLIENT
# （--source-data 位点与 SHOW MASTER STATUS 需要这些权限）
BACKUP_DIR=/var/backups/collect
# MySQL binlog directory for PITR archive (leave empty to skip)
BINLOG_DIR=/var/lib/mysql
# Off-host target, e.g. backup-host:/data/collect (requires ssh key)
BACKUP_REMOTE=
RETAIN_DAILY_DAYS=30
RETAIN_BINLOG_DAYS=7
