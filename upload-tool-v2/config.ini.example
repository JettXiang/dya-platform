; ================================================================
; 抖音 sec_uid 上传工具 v2 · 配置模板
; 用法：把本文件复制为 config.ini，填上真实连接信息（放在工具同级目录）
; 优先级：命令行参数 > 环境变量 > config.ini > config.json > 默认值
; ================================================================

[redis]
; Redis 连接信息（向管库的人要）
host = 127.0.0.1
port = 6379
db = 0
; 没有密码就留空
password =

[keys]
; 作者 sec_uid 集合：必须与原版工具一致，否则数据会分叉
set_key = douyin_topic_search_sec_id
; 作者元数据 Hash（本版新增，存昵称/合集名/视频数/首末发现时间）
meta_key = douyin_topic_search_sec_meta
